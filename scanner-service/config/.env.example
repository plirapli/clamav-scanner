# Copy to config/.env: cp config/.env.example config/.env
# Then fill in CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN below.

# fe-analysis expects the scanner on :4000 (VITE_SCANNER_API_BASE)
APP_PORT=4000
APP_NAME=scanner-service
KAFKA_BROKERS=localhost:39092
KAFKA_TOPIC=scan-logs
KAFKA_GROUP_ID=scan-log-sqlite-writer
SQLITE_PATH=data/scanner.db
CLAMAV_ADDR=127.0.0.1:3310
MAX_SCAN_SIZE=26214400

# Classifier: Cloudflare Workers AI Clef (@cf/cloudflare/clef)
# Set CLASSIFIER_ENABLED=false to run offline (static rules still apply).
CLASSIFIER_ENABLED=true
# clef or clef-flash
CLASSIFIER_MODEL=clef
# Account ID: Cloudflare dashboard > Workers AI (or the URL /<account-id>/...)
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Workers AI: Read" permission. Server-side only.
CLOUDFLARE_API_TOKEN=
CLASSIFIER_BASE_URL=https://api.cloudflare.com/client/v4
CLASSIFIER_TIMEOUT=30s
CLASSIFIER_LABELS=benign,suspicious,malicious,insufficient-evidence
CLASSIFIER_SEND_FILENAME=false

VERDICT_BLOCK_CONFIDENCE=0.95
FAIL_MODE=quarantine
ALLOW_UNSUPPORTED=true
STATIC_RULES_ENABLED=true
STATIC_RULE_VERDICT=QUARANTINE
SUSPICIOUS_IMPORTS_MIN=3
PACKER_ENTROPY_THRESHOLD=7.2
GENERIC_RULES_ENABLED=true
ENCRYPTED_VERDICT=QUARANTINE
QUARANTINE_DIR=data/quarantine
QUARANTINE_ENABLED=true
PUBLISH_ALL_VERDICTS=false

CACHE_ENABLED=true
CACHE_TTL=168h
CACHE_ERROR_TTL=15m
CACHE_MAX_ENTRIES=100000

MAX_FILES_PER_REQUEST=10

# Results shown on the frontend Evaluation page (relative to scanner-service/)
EVAL_RESULTS_DIR=../eval/results

# Eval only (go run ./cmd/eval fetch-malware). Free key: https://auth.abuse.ch/
MALWAREBAZAAR_API_KEY=
