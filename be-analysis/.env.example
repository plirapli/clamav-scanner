# OpenAI-compatible API (gunakan OpenRouter) - wajib untuk fitur analisis AI.
# Dapatkan API key di https://openrouter.ai/keys
OPENAI_API_KEY=
# Base URL OpenRouter (OpenAI-compatible)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Nama model di OpenRouter, misal: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
OPENAI_MODEL=openai/gpt-4o-mini

# MongoDB - sumber data log infeksi (sesuaikan dengan scanner-service)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=scanner_service
MONGO_COLLECTION=scan_logs