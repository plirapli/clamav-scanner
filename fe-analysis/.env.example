# Kosongkan untuk memakai Vite proxy (default: http://localhost:8000).
# Isi jika backend di host/port lain, misal http://192.168.1.10:8000
VITE_API_BASE=

# Base URL Scanner Service. Contoh: http://localhost:4000
VITE_SCANNER_API_BASE=http://localhost:4000
# Kredensial untuk endpoint /api/scanner/scan.
VITE_SCANNER_CLIENT_ID=
VITE_SCANNER_TOKEN=
